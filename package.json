{
  "name": "reacut",
  "version": "0.5.1",
  "private": true,
  "description": "An open source offline desktop video editor informed by REA research",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-plugin-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --dir",
    "preview": "vite preview",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "start": "electron .",
    "test:desktop": "npm run build && tsx tests/app-electron.ts",
    "test:timeline": "tsx tests/timeline-browser.ts",
    "icons": "tsx scripts/generate-icon.ts",
    "demo": "tsx scripts/generate-demo.ts",
    "licenses": "tsx scripts/licenses.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:visual": "npm run build && tsx tests/visual-ui-electron.ts",
    "test:storage": "npm run build && tsx tests/storage-electron.ts",
    "test:player": "npm run build && tsx tests/player-electron.ts",
    "dist:mac:installer": "npm run build && electron-builder --mac dmg zip --publish never",
    "test:tracks": "npm run build && tsx tests/track-electron.ts",
    "test:audio": "npm run build && tsx tests/audio-electron.ts",
    "test:package": "tsx tests/package-electron.ts",
    "check:desktop": "npm run build && tsx tests/app-electron.ts && tsx tests/visual-ui-electron.ts && tsx tests/storage-electron.ts && tsx tests/player-electron.ts && tsx tests/audio-electron.ts && tsx tests/track-electron.ts && tsx tests/transition-electron.ts && tsx tests/capcut-import-electron.ts",
    "test:transition": "npm run build && tsx tests/transition-electron.ts",
    "test:capcut": "npm run build && tsx tests/capcut-import-electron.ts",
    "media:build": "node scripts/build-media-tools.mjs",
    "assets": "tsx scripts/generate-assets.ts",
    "test:subtitles": "npm run build && tsx tests/subtitle-electron.ts",
    "test:portable": "npm run build && tsx tests/portable-range-electron.ts",
    "test:source": "npm run build && tsx tests/source-preview-electron.ts",
    "test:source:browser": "tsx tests/source-preview-browser.ts",
    "test:assets": "npm run build && tsx tests/assistant-assets-electron.ts",
    "test:creative": "npm run build && tsx tests/creative-library-electron.ts",
    "test:workspace": "npm run build && tsx tests/workspace-electron.ts",
    "plugin:pack": "node scripts/package-plugin.mjs",
    "test:plugin": "tsx tests/plugin-electron.ts",
    "test:plugin:launcher": "python3 tests/plugin-launcher.py",
    "test:editing": "npm run build && tsx tests/timeline-edits-electron.ts",
    "test:derivatives": "npm run build && tsx tests/derivatives-electron.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "jsdom": "^27.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "org.reacut.editor",
    "productName": "ReaCut",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "extraResources": [
        {
          "from": "media-tools/darwin-${arch}",
          "to": "media-tools",
          "filter": [
            "**/*"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "node_modules/@napi-rs/**",
      "dist/fonts/**",
      "dist/builtin-assets/**"
    ],
    "fileAssociations": [
      {
        "ext": "reacut",
        "name": "ReaCut Project",
        "role": "Editor"
      }
    ],
    "beforePack": "scripts/prepare-media-tools.cjs"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "author": "ReaCut contributors",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "fsevents": false
  }
}
