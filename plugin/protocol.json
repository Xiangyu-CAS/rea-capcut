{
  "version": "0.9.1",
  "tools": [
    {
      "name": "reacut_open",
      "description": "Open or reuse the local ReaCut editor in a supported desktop side panel. It shares its project with the MCP tools.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
