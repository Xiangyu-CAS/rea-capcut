    {
      "name": "reacut_propose_edit",
      "description": "Stage 1–40 edits for local preview when the user asks to review first. Use the exact revision and selection from reacut_state. Staging does not change the project. For requests to edit, use reacut_edit. Set the type on each action. Supported actions include addText(text,start,duration,fontSize?,color?,x?,y?), addCaptions(transcriptionId,translations?), addAsset(assetId,start,trackId?,duration?,sourceIn?), trimClip(clipId,edge,time), splitClip(clipId,time), deleteClip(clipId), moveClip(clipId,start,trackId?), setSpeed(clipId,speed), setVolume(clipId,volume?,muted?), setText(clipId,text), setTransform(clipId,x?,y?,scale?,rotation?,opacity?), setFades(clipId,fadeIn,fadeOut,audioFadeIn,audioFadeOut), and setProject(name?,width?,height?,fps?,background?). For addCaptions, use a current transcriptionId from reacut_transcribe and supply one translation per cue in order only if a different language was requested. Times are in seconds. For trimClip, use start or end for edge and the new absolute timeline position for time. Locked tracks and stale revisions are rejected.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object"
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "revision",
          "actions"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "reacut_edit",
      "description": "Use this for requests to edit the open timeline. Atomically apply 1–40 reversible edits at the exact revision returned by reacut_state. The Agent panel shows the result. One undo restores the batch. Copy an attached source range to addAsset.sourceIn and duration when using that range. If the user asks for a preview before editing, use reacut_propose_edit. Set the type on each action. Supported actions include addText(text,start,duration,fontSize?,color?,x?,y?), addCaptions(transcriptionId,translations?), addAsset(assetId,start,trackId?,duration?,sourceIn?), trimClip(clipId,edge,time), splitClip(clipId,time), deleteClip(clipId), moveClip(clipId,start,trackId?), setSpeed(clipId,speed), setVolume(clipId,volume?,muted?), setText(clipId,text), setTransform(clipId,x?,y?,scale?,rotation?,opacity?), setFades(clipId,fadeIn,fadeOut,audioFadeIn,audioFadeOut), and setProject(name?,width?,height?,fps?,background?). For addCaptions, use a current transcriptionId from reacut_transcribe and supply one translation per cue in order only if a different language was requested. Times are in seconds. For trimClip, use start or end for edge and the new absolute timeline position for time. Locked tracks and stale revisions are rejected.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object"
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "revision",
          "actions"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
