        "openai/ui": {
          "entrypoints": [
            {
              "type": "thread"
            }
          ]
        }
      }
    },
    {
      "name": "reacut_open_project",
      "description": "Ask the user to choose an existing ReaCut project in the local file picker. Save any unsaved changes first and supply the current revision from reacut_state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          }
